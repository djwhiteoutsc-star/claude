; Engine configuration file.
; Input actions are registered at startup in scripts/autoload/game_state.gd
; so they live in version-controlled code rather than serialized key events.

config_version=5

[application]

config/name="Hall Pass"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Network="*res://scripts/autoload/network.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
